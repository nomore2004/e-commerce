# Environment Configuration for ProcureX Backend
PROJECT_NAME="ProcureX Admin API"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=procurex_user
POSTGRES_PASSWORD=procurex_password
POSTGRES_DB=procurex_db

# Security & JWT
# IMPORTANT: Generate a strong secret key for production (e.g., openssl rand -hex 32)
SECRET_KEY=procurex_insecure_development_secret_key_change_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials
FIRST_SUPERUSER_EMAIL=admin@procurex.com
FIRST_SUPERUSER_PASSWORD=Admin@123456
FIRST_SUPERUSER_NAME="ProcureX Administrator"
